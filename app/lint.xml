<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!-- "Accessibility" is a lint *category* id: every current accessibility
         check — and any added in future AGP releases — fails the build
         instead of warning. -->
    <issue id="Accessibility" severity="error" />

    <!-- warningsAsErrors would turn these into build failures whenever a newer
         library, AGP or Android release ships, which happens independently of
         any change in this repo. Dependabot owns dependency and AGP versions;
         targetSdk follows Play's yearly deadline. They stay in the report
         without blocking the build. -->
    <issue id="GradleDependency" severity="informational" />
    <issue id="AndroidGradlePluginVersion" severity="informational" />
    <issue id="OldTargetApi" severity="informational" />
    <!-- Same reasoning, and it is the one that actually bit: any dependency
         publishing a patch release turned this into a build error, which took
         lintDebug down before the unit tests could run. -->
    <issue id="NewerVersionAvailable" severity="informational" />
</lint>
